# Pooled Lakebase Postgres URL. The Worker reads this at runtime.
# Local: copy to .env.local. Deployed: set it as a Cloudflare Worker secret.
DATABASE_URL=

# Absolute origin for canonical URLs and the sitemap, once this app has a production host.
# Leave unset rather than pointing it at the temporary workers.dev deployment.
# NEXT_PUBLIC_SITE_URL=
